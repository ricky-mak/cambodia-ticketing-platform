# Copy to .env.local for local development.
# NEVER commit real secrets. In production these come from Secret Manager.

# Application
NODE_ENV=development
APPLICATION_BASE_URL=http://localhost:3000

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing

# Initial admin account (used only by `yarn create-admin`, not by the app).
# Prefer setting these as shell env vars rather than committing them.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-me-at-least-12-chars

# Protects internal task endpoints (/api/internal/*). Optional in dev; if unset,
# internal routes are allowed in non-production only. Required in production.
INTERNAL_API_SECRET=

# Payments (Phase 5). PAYMENT_PROVIDER: "fake" (default, dev) or "payway".
PAYMENT_PROVIDER=fake
# Required when PAYMENT_PROVIDER=payway (from your ABA sandbox registration email):
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Sandbox: https://checkout-sandbox.payway.com.kh | Prod: https://checkout.payway.com.kh
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

# Tickets & email (Phase 6)
# Secret for signing QR ticket tokens. Use a long random value, e.g.
# PowerShell:  [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
TICKET_SIGNING_SECRET=
# Email provider: "fake" (default, dev — writes previews to ./.emails) or "resend".
EMAIL_PROVIDER=fake
# Required when EMAIL_PROVIDER=resend (from-address must be verified in Resend):
EMAIL_API_KEY=
EMAIL_FROM=Tickets <tickets@yourdomain.com>

# --- Added in later phases (kept here for reference) ---
# SESSION_SECRET=
# CLOUD_TASKS_SERVICE_ACCOUNT=
# CLOUD_TASKS_AUDIENCE=
